# Puerto del servidor Express
PORT=5000

# Secreto usado para firmar los JWT.
# Este valor vale tal cual para desarrollo local; sustituir solo si se despliega.
JWT_SECRET=change_this_secret

# Duracion del token de sesion
JWT_EXPIRES_IN=7d

# Comision aplicada a cada operacion (0.005 = 0.5%)
TRADING_FEE_RATE=0.005

# Ruta del archivo SQLite
DATABASE_PATH=./data/trading.db

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Intervalo (ms) de actualizacion de los precios simulados
PRICE_TICK_INTERVAL_MS=3000

# Volatilidad por tick (0.0035 = +-0.35% aprox.)
PRICE_VOLATILITY=0.0035
